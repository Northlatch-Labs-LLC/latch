# Latch 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# 所有 endpoint 未设置时都默认 Latch 产品端点（见 packages/shared/src/zcodeEndpoint.ts），
# 不存在 vendor 默认地址。
ZCODE_BASE_URL=https://latch.gridframes.app
BIGMODEL_API_BASE_URL=https://latch.gridframes.app
ZAI_BUSINESS_BASE_URL=https://latch.gridframes.app

# Z.ai web OAuth 已改为显式配置：留空即保持 vendor web 登录禁用（第一方登录走 Latch gateway key）。
# 仅在自建 Z.ai 兼容授权服务时填写；client id 是公开标识，不是 secret。
# Web 构建经 vite 注入读取 VITE_ 前缀，桌面端/服务端读取无前缀的同名变量，语义相同。
VITE_ZAI_OAUTH_CLIENT_ID=
VITE_ZAI_OAUTH_ORIGIN=
ZAI_OAUTH_CLIENT_ID=
ZAI_OAUTH_ORIGIN=

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://latch.gridframes.app/cn/share

# 远程资源 CDN 根地址（自动按版本拼接 /latch/electron/releases/<版本>）。
# 留空/删除即不配置任何下载源（默认），不会回退到任何第三方 CDN。
ZCODE_CDN_BASE_URL=
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=

# 可选本地 Provider 配置文件路径；留空使用内置配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# Latch 账号后端（xlaunch gateway customer-api）的可覆盖地址，默认见
# packages/services/src/latch-account/config.ts。CLI/桌面/服务端读这些值指向上游 gateway。
# 注意：Web 浏览器端的账号请求永远走同源 /api/latch-account/* 代理
# （packages/server/src/latchAccountProxy.ts 注册，代理上游才读 LATCH_ACCOUNT_API_URL），
# 不受这些值的直接影响；自建 Web 服务时改的是这里 + 服务端 env，而不是浏览器侧。
LATCH_ACCOUNT_API_URL=https://gateway.xlaunch.work/customer-api
LATCH_ACCOUNT_MANAGE_URL=https://xlaunch.work/account
LATCH_ACCOUNT_PURCHASE_URL=https://xlaunch.work/account?plan=pro

# 内网或私有部署地址没有默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
